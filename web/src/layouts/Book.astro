---
import Base from "./Base.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { BASE, bookPath, chapterPath, deckPath } from "../lib/paths";
import { getBooks, type Book, type Chapter } from "../lib/site";
import { neighbours } from "../lib/chapters";

interface Props {
  book: Book;
  chapters: Chapter[];          // published chapters of this book, sorted
  current?: Chapter;            // undefined on the book TOC page
  headings?: { depth: number; slug: string; text: string }[];
}
const { book, chapters, current, headings = [] } = Astro.props;
const books = await getBooks();
const nav = current ? neighbours(chapters, current.id) : { prev: undefined, next: undefined };
const parts = book.data.parts.length ? book.data.parts : [{ key: "", title: "" }];
const chaptersIn = (key: string) => chapters.filter((c) => (c.data.part ?? "") === key);
const h2s = headings.filter((h) => h.depth === 2);
---
<Base title={current ? current.data.title : book.data.title} description={current?.data.summary} render="book">
  <header class="bar">
    <div class="bar-inner">
      <a class="brand" href={BASE}>Agentic Coding Playbook</a>
      <details class="book-menu">
        <summary aria-label="Switch book">Book {book.data.order} · {book.data.title}</summary>
        <ul>
          {books.map((b) => (
            <li>
              <a href={bookPath(BASE, b.slug)} aria-current={b.slug === book.slug ? "true" : undefined}>
                <span class="menu-num">Book {b.data.order}</span>
                <span>{b.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <div class="bar-right">
        <div id="search" class="search"></div>
        <ThemeToggle />
      </div>
    </div>
  </header>
  <div class="shell" class:list={{ "no-toc": !current }} data-shell>
    <nav class="panel sidebar" aria-label="Book contents">
      <button class="panel-toggle" type="button" data-toggle="left" aria-expanded="true" aria-label="Toggle book contents"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="2"/><path d="M6 2.5v11"/></svg></button>
      <div class="panel-body">
        {parts.map((p) => (
          <div class="part">
            {p.title && <div class="part-title">{p.key} · {p.title}</div>}
            <ol>
              {chaptersIn(p.key).map((c) => (
                <li aria-current={current?.id === c.id ? "page" : undefined}>
                  <a href={chapterPath(BASE, book.slug, c.slug)}>{c.data.order}. {c.data.title}</a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </nav>
    <main class="main prose" data-pagefind-body={current ? "" : undefined}>
      <slot />
      {current && (
        <footer class="chapter-nav">
          <span>{nav.prev ? <a href={chapterPath(BASE, book.slug, nav.prev.slug)}>← {nav.prev.data.title}</a> : <a href={bookPath(BASE, book.slug)}>← Book contents</a>}</span>
          <span>{nav.next && <a href={chapterPath(BASE, book.slug, nav.next.slug)}>{nav.next.data.title} →</a>}</span>
        </footer>
      )}
    </main>
    {current && (
      <aside class="panel toc" aria-label="On this page">
        <button class="panel-toggle" type="button" data-toggle="right" aria-expanded="true" aria-label="Toggle on-page contents"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="2"/><path d="M6 2.5v11"/></svg></button>
        <div class="panel-body">
          <div class="toc-title">On this page</div>
          <ul>{h2s.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          <a class="deck-link" href={deckPath(BASE, book.slug, current.slug)}>Open as deck →</a>
        </div>
      </aside>
    )}
  </div>
</Base>

<style>
  /* Header and content share one container width, so their edges line up. */
  .bar { border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--bg); z-index: 3; }
  /* Fixed height so the sticky panels below can use a constant offset. */
  .bar-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; height: var(--bar-h); padding: 0 1.25rem; max-width: 80rem; margin: 0 auto; }
  .brand { font-weight: 600; color: var(--text); text-decoration: none; }
  .bar-right { display: flex; align-items: center; justify-content: flex-end; gap: 0.75rem; }
  .search { min-width: 12rem; }

  .book-menu { position: relative; font-size: 0.9rem; }
  .book-menu summary { list-style: none; cursor: pointer; padding: 0.3rem 0.9rem; border-radius: 999px; color: var(--text); white-space: nowrap; }
  .book-menu summary::-webkit-details-marker { display: none; }
  .book-menu summary::after { content: "▾"; margin-left: 0.5rem; color: var(--text-faint); }
  .book-menu summary:hover, .book-menu[open] summary { background: var(--bg-raised); }
  .book-menu ul { position: absolute; left: 50%; transform: translateX(-50%); top: calc(100% + 0.4rem); min-width: 18rem; list-style: none; margin: 0; padding: 0.4rem; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); z-index: 4; }
  .book-menu li a { display: grid; grid-template-columns: 4rem 1fr; gap: 0.6rem; padding: 0.5rem 0.7rem; border-radius: 10px; color: var(--text); text-decoration: none; }
  .book-menu li a:hover { background: var(--bg-raised); }
  .book-menu li a[aria-current] { color: var(--accent); font-weight: 600; }
  .menu-num { color: var(--text-faint); font-size: 0.8rem; }

  .shell { --left: 16rem; --right: 14rem; display: grid; grid-template-columns: var(--left) minmax(0, 1fr) var(--right); gap: 2.5rem; padding: 2.25rem 1.25rem 3rem; max-width: 80rem; margin: 0 auto; }
  .shell.no-toc { --right: 0px; }
  .shell[data-left="closed"] { --left: 1.6rem; }
  .shell[data-right="closed"] { --right: 1.6rem; }
  /* top = header height + the shell's top padding, so a panel never shifts relative to the viewport. */
  .panel { font-size: 0.88rem; position: sticky; top: calc(var(--bar-h) + 1.5rem); align-self: start; max-height: calc(100vh - var(--bar-h) - 3rem); overflow-y: auto; min-height: 2rem; }
  .panel-toggle { background: none; border: 0; color: var(--text-faint); width: 1.6rem; height: 1.6rem; cursor: pointer; padding: 0; margin-bottom: 0.4rem; display: grid; place-items: center; opacity: 0; transition: opacity 0.15s; }
  .panel:hover .panel-toggle, .panel-toggle:focus-visible, .shell[data-left="closed"] .sidebar .panel-toggle, .shell[data-right="closed"] .toc .panel-toggle { opacity: 1; }
  .panel-toggle:hover { color: var(--text); background: var(--bg-raised); }
  .panel-toggle svg { width: 1rem; height: 1rem; }
  .sidebar .panel-toggle { margin-left: auto; }
  .toc .panel-toggle svg { transform: scaleX(-1); }
  .shell[data-left="closed"] .sidebar .panel-body, .shell[data-right="closed"] .toc .panel-body { display: none; }
  .part-title { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); margin: 1rem 0 0.3rem; }
  .sidebar ol, .toc ul { list-style: none; margin: 0; padding: 0; }
  .sidebar li a, .toc li a { display: block; padding: 0.25rem 0; color: var(--text-muted); text-decoration: none; }
  .sidebar li[aria-current] a { color: var(--accent); font-weight: 600; }
  .sidebar li a:hover, .toc li a:hover { color: var(--text); }
  .toc-title { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); margin-bottom: 0.3rem; }
  .deck-link { display: inline-block; margin-top: 1rem; }
  .chapter-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  @media (max-width: 1000px) {
    .shell, .shell[data-left="closed"], .shell[data-right="closed"] { grid-template-columns: 1fr; }
    .panel { position: static; max-height: none; }
    .panel-toggle { display: none; }
    .bar-inner { grid-template-columns: 1fr auto; }
    .bar-inner .book-menu { justify-self: end; }
    .shell[data-left="closed"] .sidebar .panel-body, .shell[data-right="closed"] .toc .panel-body { display: block; }
    .search { display: none; }
  }
</style>

<script>
  import { readJSON, writeJSON } from "../lib/storage";
  const shell = document.querySelector<HTMLElement>("[data-shell]");
  if (shell) {
    for (const side of ["left", "right"] as const) {
      const key = `panel:${side}`;
      const button = shell.querySelector<HTMLButtonElement>(`[data-toggle="${side}"]`);
      const apply = (open: boolean) => {
        shell.dataset[side] = open ? "open" : "closed";
        button?.setAttribute("aria-expanded", String(open));
      };
      apply(readJSON<boolean>(key, true));
      button?.addEventListener("click", () => {
        const open = shell.dataset[side] !== "open";
        apply(open);
        writeJSON(key, open);
      });
    }
  }
  // Close the book menu when clicking elsewhere.
  const menu = document.querySelector<HTMLDetailsElement>(".book-menu");
  document.addEventListener("click", (e) => {
    if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
  });
</script>

<link rel="stylesheet" href={`${BASE}pagefind/pagefind-ui.css`} />
<script is:inline define:vars={{ base: BASE }}>
  // The bundle exists only after `npm run build`; in `astro dev` the script 404s and the box stays empty.
  var s = document.createElement("script");
  s.src = base + "pagefind/pagefind-ui.js";
  s.onload = function () {
    new PagefindUI({ element: "#search", bundlePath: base + "pagefind/", showSubResults: true, showImages: false });
  };
  document.head.appendChild(s);
</script>

<style is:global>
  .search { --pagefind-ui-scale: 0.8; --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--text); --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--border); --pagefind-ui-font: var(--font-sans); --pagefind-ui-border-radius: 999px; }
</style>
