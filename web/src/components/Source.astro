---
interface Props {
  who: string;
  work: string;
  year?: number | string;
  href?: string;
  /** "read": the quoted text is verbatim from a source read in full. "stated": a paraphrase of the source's position. */
  provenance: "read" | "stated";
}
const { who, work, year, href, provenance } = Astro.props;
---
<figure class="source" data-provenance={provenance}>
  <blockquote class="source-body"><slot /></blockquote>
  <figcaption>
    <b>{who}</b>, {href ? <a href={href} rel="noopener"><cite>{work}</cite></a> : <cite>{work}</cite>}{year && <span>, {year}</span>}{provenance === "stated" && <span class="source-note">. Paraphrased.</span>}
  </figcaption>
</figure>

<style>
  .source { margin: 1.75rem 0; padding: 0 0 0 1.75rem; position: relative; }
  .source::before { content: "“"; position: absolute; left: 0; top: -0.35rem; font-size: 2.4rem; line-height: 1; color: var(--accent); font-family: Georgia, serif; }
  .source-body { margin: 0; font-size: 1.05rem; }
  .source-body :global(q) { display: block; font-style: italic; margin: 0; }
  .source-body :global(q)::before, .source-body :global(q)::after { content: none; }
  figcaption { margin-top: 0.5rem; font-size: 0.88rem; color: var(--text-muted); }
  cite { font-style: normal; }
  .source-note { color: var(--text-faint); }
</style>
