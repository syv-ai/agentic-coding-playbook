---
/** A collapsible section: a summary line with a chevron, the body slides open. Rendered open in the deck. */
interface Props {
  title: string;
  open?: boolean;
}
const { title, open = false } = Astro.props;
---
<details class="fold" open={open}>
  <summary>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5"/></svg>
    <span>{title}</span>
  </summary>
  <div class="fold-body"><div class="fold-inner"><slot /></div></div>
</details>

<style is:global>
  .fold { margin: 2.5rem 0; }
  .fold > summary { list-style: none; display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-weight: 600; color: var(--text-strong); padding: 0.25rem 0; }
  .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary svg { width: 1rem; height: 1rem; color: var(--text-faint); transition: transform 0.25s ease; flex: none; }
  .fold[open] > summary svg { transform: rotate(90deg); }
  .fold > summary:hover svg { color: var(--accent); }
  /* Anything that moves other content slides. */
  .fold-body { overflow: hidden; transition: height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .fold-inner { padding: 0.75rem 0 0.25rem 1.6rem; }
  .fold-inner > :last-child { margin-bottom: 0; }
  @media (prefers-reduced-motion: reduce) { .fold-body, .fold > summary svg { transition: none; } }
  html[data-render="deck"] .fold > summary { display: none; }
  html[data-render="deck"] .fold-inner { padding-left: 0; }
</style>

<script>
  const deck = document.documentElement.dataset.render === "deck";
  // No transition under reduced motion, so no transitionend to wait for: let the native toggle do its work.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const fold of document.querySelectorAll<HTMLDetailsElement>("details.fold")) {
    if (deck) { fold.open = true; continue; }
    if (still) continue;
    const summary = fold.querySelector("summary")!;
    const body = fold.querySelector<HTMLElement>(".fold-body")!;
    summary.addEventListener("click", (e) => {
      e.preventDefault();
      if (fold.open) {
        body.style.height = `${body.offsetHeight}px`;
        requestAnimationFrame(() => { body.style.height = "0px"; });
        body.addEventListener("transitionend", () => { fold.open = false; body.style.height = ""; }, { once: true });
      } else {
        fold.open = true;
        const to = body.scrollHeight;
        body.style.height = "0px";
        requestAnimationFrame(() => { body.style.height = `${to}px`; });
        body.addEventListener("transitionend", () => { body.style.height = ""; }, { once: true });
      }
    });
  }
</script>
