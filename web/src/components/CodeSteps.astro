---
/**
 * Code that changes over several steps, in the Interactive layout. Every step is highlighted at build time;
 * src/scripts/code-steps.ts moves the lines between steps. Two steps is the plain before-and-after case.
 */
import { Code } from "astro:components";
import { SHIKI_THEMES } from "../lib/shiki";

interface Step {
  /** One line under the title while this step shows. */
  desc: string;
  /** The code for this step, as a template literal. */
  code: string;
  /** A sentence or two under the code, optional. */
  note?: string;
}
interface Props {
  title: string;
  /** Shiki language id: "python", "ts", "bash", … */
  lang: string;
  steps: Step[];
  /** Small muted suffix after the title, optional. */
  meta?: string;
  /** Seconds per step. Set to cycle through the steps on its own, wrapping; the pointer over the block holds it. */
  auto?: number;
  /** Show the Previous and Next pills. Off is for blocks that run themselves. */
  controls?: boolean;
}
const { title, lang, steps, meta, auto, controls = true } = Astro.props;
if (steps.length < 2) throw new Error(`<CodeSteps> "${title}" needs at least two steps.`);
---
<section class="ix code-steps" class:list={{ "is-reserved": !!auto }} data-code-steps data-auto={auto ? Math.round(auto * 1000) : undefined} data-pagefind-ignore>
  <header class="ix-head steps-head">
    <h3 class="ix-title">{title}{meta && <span class="ix-meta"> · {meta}</span>}</h3>
    <span class="steps-dots" data-steps-dots role="img" aria-label={`Step 1 of ${steps.length}`}>{steps.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</span>
    <div class="steps-stack">
      <p class="ix-desc" data-steps-desc>{steps[0].desc}</p>
      {steps.map((s) => <p class="ix-desc steps-ghost" aria-hidden="true">{s.desc}</p>)}
    </div>
    {controls && (
      <div class="ix-action">
        <button type="button" class="btn" data-steps-prev disabled>Previous</button>
        <button type="button" class="btn btn-primary" data-steps-next>Next</button>
      </div>
    )}
  </header>
  <div class="steps-stage steps-stack" data-steps-stage>
    <div class="steps-live" data-steps-live><Code code={steps[0].code} lang={lang as never} themes={SHIKI_THEMES} defaultColor={false} /></div>
    {steps.map((s) => (
      <div class="steps-ghost" data-step data-desc={s.desc} data-note={s.note} aria-hidden="true">
        <Code code={s.code} lang={lang as never} themes={SHIKI_THEMES} defaultColor={false} />
      </div>
    ))}
  </div>
  <div class="steps-stack">
    <p class="steps-note" data-steps-note hidden={!steps[0].note}>{steps[0].note}</p>
    {steps.map((s) => <p class="steps-note steps-ghost" aria-hidden="true">{s.note}</p>)}
  </div>
</section>

<style is:global>
  /* Two rows: the title with the dots at its right, then the description with the buttons at its right. */
  .steps-head { grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; align-items: center; row-gap: 0.35rem; column-gap: 2rem; }
  .steps-head .ix-title { grid-area: 1 / 1; }
  .steps-head .steps-dots { grid-area: 1 / 2; justify-self: end; }
  .steps-head .steps-stack { grid-area: 2 / 1; }
  .steps-head .ix-action { grid-area: 2 / 2; gap: 0.35rem; }
  .steps-head .ix-desc { margin-top: 0; }
  .steps-dots { display: inline-flex; gap: 0.5rem; align-items: center; }
  .steps-dots i { width: 10px; height: 10px; border-radius: 999px; background: var(--border); transition: background 0.3s; }
  .steps-dots i.on { background: var(--accent); }
  /* Height is pinned while lines move; leaving lines sit out of flow at their old row and must never scroll. */
  .steps-stage { margin: 2.5rem 0; }
  .steps-stage pre { margin: 0; overflow-y: hidden; transition: height 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
  /* Every step is in the HTML. Ghost copies are hidden; in a reserved block they stack in one grid cell,
     so the block is as tall as its tallest step, longest description and longest note from the first paint. */
  .steps-ghost { display: none; }
  .is-reserved .steps-stack { display: grid; }
  .is-reserved .steps-stack > * { grid-area: 1 / 1; }
  .is-reserved .steps-ghost { display: block; visibility: hidden; pointer-events: none; }
  .is-reserved .steps-note[hidden] { display: block; visibility: hidden; }
  /* Anything that moves other content slides: a description or note that wraps pushes the code down smoothly. */
  .code-steps .ix-head, .code-steps .steps-note { transition: height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  /* While the height is pinned for the slide, the row must hug the top, or the grid centres it in the spare space and the title dips. */
  .code-steps .ix-head { margin-bottom: 1.75rem; align-content: start; }
  @media (max-width: 600px) { .steps-head { grid-template-columns: minmax(0, 1fr) auto; } }
  .steps-stage code { position: relative; display: block; }
  /* Motion: removed lines lift first, kept lines glide, new lines rise in last. */
  .steps-stage .line { border-radius: 4px; transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s, opacity 0.5s ease 0.45s, background-color 0.6s ease; }
  .steps-stage .line.chg { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .steps-stage .line.chg::before { color: var(--accent); }
  .steps-stage .line.enter { opacity: 0; transform: translateY(0.5rem); }
  .steps-stage .line.leave-pre { position: absolute; left: 0; right: 0; pointer-events: none; }
  /* A leaving line keeps its old number and must not shift the numbers of the lines that stay. */
  .steps-stage .line.leave-pre::before { counter-increment: none; }
  .steps-stage .line.leave { opacity: 0; transform: translateY(-0.5rem); transition: transform 0.35s ease, opacity 0.35s ease; }
  .steps-note { font-size: 0.95rem; color: var(--text-muted); margin: 0; }
  .prose .code-steps .steps-note { margin: 0; }
  @media (prefers-reduced-motion: reduce) { .steps-stage pre, .steps-stage .line, .code-steps .ix-head, .code-steps .steps-note { transition: none; } }
</style>

<script>
  import { mountCodeSteps } from "../scripts/code-steps";
  mountCodeSteps();
</script>
